<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ZENIX / MUSIC" android:textSize="11sp" android:textColor="#B7CAE4" android:letterSpacing="0.16"/>
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:scaleType="fitCenter" android:src="@drawable/zenix_icon" android:contentDescription="歌曲封面"/>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="你的音乐，自成宇宙。" android:textSize="17sp" android:textStyle="bold" android:textColor="#F2F6FF" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="打开 Zenix 开始播放" android:textSize="12sp" android:textColor="#BDC9DD" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/widget_previous" android:layout_width="55dp" android:layout_height="44dp" android:text="Ⅰ◀" android:contentDescription="上一首" android:textColor="#ECF3FF" android:textSize="20sp" android:gravity="center" android:background="@drawable/widget_button"/>
        <TextView android:id="@+id/widget_toggle" android:layout_width="65dp" android:layout_height="44dp" android:layout_marginHorizontal="12dp" android:text="▶" android:contentDescription="播放或暂停" android:textColor="#ECF3FF" android:textSize="20sp" android:gravity="center" android:background="@drawable/widget_button"/>
        <TextView android:id="@+id/widget_next" android:layout_width="55dp" android:layout_height="44dp" android:text="▶Ⅰ" android:contentDescription="下一首" android:textColor="#ECF3FF" android:textSize="20sp" android:gravity="center" android:background="@drawable/widget_button"/>
    </LinearLayout>
</LinearLayout>
