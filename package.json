{
  "name": "zenix-music-player",
  "productName": "Zenix Music Player",
  "description": "Zenix 桌面音乐播放器，玻璃贴纸音乐空间与桌面歌词",
  "author": "17hwliao",
  "version": "0.2.1",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on tcp:5174 && cross-env ZENIX_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "android:dev": "vite --mode android --host 127.0.0.1 --port 5175",
    "android:build": "node scripts/Prepare-Android.mjs && tsc --noEmit && vite build --mode android && cap sync android",
    "android:apk": "npm run android:build && powershell -ExecutionPolicy Bypass -File scripts/Build-Android.ps1",
    "android:open": "cap open android",
    "ios:dev": "vite --mode ios --host 127.0.0.1 --port 5176",
    "ios:web": "node scripts/Prepare-iOS.mjs && tsc --noEmit && vite build --mode ios",
    "ios:sync": "npm run ios:web && cross-env ZENIX_PLATFORM=ios cap sync ios",
    "ios:open": "cross-env ZENIX_PLATFORM=ios cap open ios",
    "ios:simulator": "node scripts/Build-iOS.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@paper-design/shaders-react": "^0.0.80",
    "framer-motion": "^13.0.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.31.0",
    "music-metadata": "^11.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
