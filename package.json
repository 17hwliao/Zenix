{
  "name": "zenix-music-player",
  "productName": "Zenix Music Player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on tcp:5174 && cross-env ZENIX_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "^4.40.1",
    "@paper-design/shaders-react": "^0.0.80",
    "framer-motion": "^13.0.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.31.0",
    "music-metadata": "^11.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^43.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
